            "required": ["data"]
        },
        {
            "description": "Notification that the configuration changed",
            "properties": {
                "module": {"enum": ["matter"]},
                "kind": {"enum": ["notification"]},
                "action": {"enum": ["update_settings"]},
                "data": {"$ref": "#/definitions/matter_settings"}
            },
            "additionalProperties": false,
