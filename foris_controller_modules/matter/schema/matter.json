                    },
                    "additionalProperties": false,
                    "required": ["error"]
                }
            },
            "additionalProperties": false,
            "required": ["data"]
        },
        {
            "description": "Notification that a controller was unpaired",
            "properties": {
                "module": {"enum": ["matter"]},
                "kind": {"enum": ["notification"]},
                "action": {"enum": ["remove_fabric"]},
                "data": {
                    "type": "object",
