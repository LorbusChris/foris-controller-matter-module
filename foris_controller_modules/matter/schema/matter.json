{
    "definitions": {
        "matter_error": {"type": "integer", "minimum": 0},
        "matter_window": {"enum": ["closed", "basic", "enhanced", "unknown"]},
        "matter_fabric_index": {"type": "integer", "minimum": 1, "maximum": 254},
        "matter_manual_code": {"type": "string", "pattern": "^[0-9]{11,21}$"},
        "matter_qr_payload": {"type": "string", "pattern": "^MT:[0-9A-Z.-]+$"},
        "matter_fabric": {"type": "object"},
        "matter_endpoint": {"type": "object"},
        "matter_directory_entry": {"type": "object"},
        "matter_window_result": {
            "type": "object",
            "properties": {
                "error": {"$ref": "#/definitions/matter_error"},
                "window": {"$ref": "#/definitions/matter_window"}
            },
            "additionalProperties": false,
            "required": ["error"]
        },
        "matter_settings": {
            "description": "What matter-netman reads from uci at startup. Optional strings are '' when unset, and writing '' deletes the option so the init script's own fallback stays the single source of the default.",
            "type": "object",
            "properties": {
                "wifi_share": {"type": "boolean"},
                "wifi_network": {"type": "string", "minLength": 1},
                "wifi_iface": {"type": "string"},
                "primary_interface": {"type": "string", "minLength": 1},
                "vendor_name": {"type": "string", "maxLength": 32},
                "product_name": {"type": "string", "maxLength": 32},
                "ethernet_diagnostics": {"type": "boolean"},
                "diagnostics_interface": {"type": "string"}
            },
            "additionalProperties": false,
            "required": [
                "wifi_share",
                "wifi_network",
                "wifi_iface",
                "primary_interface",
                "vendor_name",
                "product_name",
                "ethernet_diagnostics",
                "diagnostics_interface"
            ]
        }
    },
    "oneOf": [
        {
            "description": "Request the onboarding status",
            "properties": {
                "module": {"enum": ["matter"]},
                "kind": {"enum": ["request"]},
                "action": {"enum": ["get_onboarding"]}
            },
            "additionalProperties": false
        },
        {
            "description": "Reply with the onboarding status. 'present' false means no Matter manager is installed here; 'present' with 'live' false means one is installed but its daemon is not answering. The pairing code and QR payload appear only while a commissioning window is open, because that is the only time they authenticate.",
            "properties": {
                "module": {"enum": ["matter"]},
                "kind": {"enum": ["reply"]},
                "action": {"enum": ["get_onboarding"]},
                "data": {
                    "type": "object",
                    "properties": {
                        "present": {"type": "boolean"},
                        "live": {"type": "boolean"},
                        "commissioned": {"type": "boolean"},
                        "fabrics": {"type": "integer", "minimum": 0},
                        "fabric_list": {
                            "type": "array",
                            "items": {"$ref": "#/definitions/matter_fabric"}
                        },
                        "thread_managed": {"type": "boolean"},
                        "endpoints": {
                            "type": "array",
                            "items": {"$ref": "#/definitions/matter_endpoint"}
                        },
                        "directory": {
                            "type": "array",
                            "items": {"$ref": "#/definitions/matter_directory_entry"}
                        },
                        "wifi_share": {"oneOf": [{"type": "boolean"}, {"enum": [null]}]},
                        "wifi_ssid": {"oneOf": [{"type": "string"}, {"enum": [null]}]},
                        "window": {"$ref": "#/definitions/matter_window"},
                        "manual_code": {"$ref": "#/definitions/matter_manual_code"},
                        "qr": {"$ref": "#/definitions/matter_qr_payload"},
                        "qr_svg": {"type": "string"}
                    },
                    "additionalProperties": false,
                    "required": ["present"]
                }
            },
            "additionalProperties": false,
            "required": ["data"]
        },
        {
            "description": "Request to open a commissioning window",
            "properties": {
                "module": {"enum": ["matter"]},
